# Mars Rover Endpoint Configuration

# Science Report Directories
# Override these to customize where science reports are stored
# Default: project_root/endpoint/storage/sci_reports and project_root/endpoint/storage/report_sci_gen
#SCIENCE_REPORT_OUTPUT_DIR=/custom/path/to/sci_reports
#SCIENCE_REPORT_SOURCE_DIR=/custom/path/to/report_sci_gen

# Captures and both report subsystems share these expedition directories.
# The spelling of the default Linux username is intentional.
#EXPEDITION_BASE_DIR=/home/administratror/expeditions/unprocessed
#EXPEDITION_PROCESSED_DIR=/home/administratror/expeditions/processed

# ROSBridge Configuration
ROSBRIDGE_HOST=localhost
ROSBRIDGE_PORT=9090

# API Configuration
API_PORT=6767
